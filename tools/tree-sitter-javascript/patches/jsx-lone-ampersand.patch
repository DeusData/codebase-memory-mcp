+    // cbm fork (#1736): '&' directly before the closing quote is excluded so the
+    // fragment cannot run past the end of the string (upstream: &[^#A-Za-z]).
+    unescaped_double_jsx_string_fragment: _ => token.immediate(prec(1, /([^"&]|&[^#A-Za-z"])+/)),
 
