{
  "suite": "C-SG-SEM",
  "title": "search_graph semantic_query (full/moderate index) and mixed-mode rules",
  "spec": "specs/05_search_graph.md",
  "backends": ["sqlite", "neo4j"],
  "cases": [
    {"id": "SEM-01", "tier": 2, "title": "a natural-language description finds the money formatter in the top ranks", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["turn an amount of cents into a printable dollar string"], "semantic_limit": 10, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "semantic_total", "op": "gte", "value": 1}],
                "rows": {"table": "semantic", "col": "qn", "any_match": "format"}}},
    {"id": "SEM-02", "tier": 2, "title": "several keywords are scored together (semantic_query takes keywords, not phrases)", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["validate", "order", "receipt", "notify"], "semantic_limit": 10, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "rows": {"table": "semantic", "col": "qn", "any_match": "validate|notify|checkout"}}},
    {"id": "SEM-03", "tier": 2, "title": "semantic_limit bounds the ranked rows", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["money"], "semantic_limit": 2, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "semantic_returned", "op": "lte", "value": 2}]}},
    {"id": "SEM-04", "tier": 2, "title": "semantic_offset pages independently of the structural offset", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["money"], "semantic_limit": 2, "semantic_offset": 2, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "semantic_next_offset", "op": "exists"}]}},
    {"id": "SEM-05", "tier": 2, "title": "semantic + label: the structural page holds only that label, and the semantic set is returned beside it, ranked on its own (documented: combined calls keep both result sets)", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["money"], "label": "Method", "semantic_limit": 10, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "rows": [{"table": "", "col": "label", "all_match": "^Method$"}],
                "json": [{"path": "semantic_returned", "op": "gte", "value": 1}]}},
    {"id": "SEM-06", "tier": 2, "title": "semantic + file_pattern: the structural page holds only Java files; the semantic set is returned beside it", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["money"], "file_pattern": "**/*.java", "semantic_limit": 10, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "rows": [{"table": "", "col": "file", "all_match": "\\.java$"}],
                "json": [{"path": "semantic_returned", "op": "gte", "value": 1}]}},
    {"id": "SEM-07", "tier": 1, "title": "semantic_query with query is refused",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["money"], "query": "money", "format": "json"}, "wait": 120,
     "expect": {"ok": false}},
    {"id": "SEM-08", "tier": 2, "title": "the schema lists the edge types of a full index (SEMANTICALLY_RELATED appears only when bodies are similar enough; eval-small has none, BATCH-SRVC has thousands)", "skip_if": "mode!=full",
     "tool": "get_graph_schema", "args": {"project": "{{project}}", "format": "json"}, "wait": 120,
     "expect": {"ok": true, "deep_contains": "CALLS"}},
    {"id": "SEM-09", "tier": 2, "title": "the two money helpers (Python and Java) are linked by a semantic edge", "skip_if": "mode!=full",
     "tool": "query_graph", "args": {"project": "{{project}}", "query": "MATCH (a)-[:SIMILAR_TO|SEMANTICALLY_RELATED]-(b) WHERE a.name = 'round_cents' RETURN DISTINCT b.name ORDER BY b.name", "format": "json"}, "wait": 120,
     "expect": {"ok": true}},
    {"id": "SEM-10", "tier": 2, "title": "semantic answers are served locally even on a Neo4j project (reply says so)", "skip_if": ["sqlite", "mode!=full"],
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["money"], "semantic_limit": 3, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "graph_backend.kind", "op": "eq", "value": "neo4j"}]}},
    {"id": "SEM-11", "tier": 2, "title": "semantic search answers within 15 s on the small fixture", "skip_if": "mode!=full",
     "tool": "search_graph", "args": {"project": "{{project}}", "semantic_query": ["order checkout"], "semantic_limit": 5, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "ms_under": 15000}}
  ]
}
