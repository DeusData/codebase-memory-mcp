{
 "suite": "C-COV",
 "title": "Index creation coverage: files, symbols, edges, ignored paths, freshness, coverage tools, recall script",
 "spec": "specs/04_index_coverage.md",
 "backends": [
  "sqlite",
  "neo4j"
 ],
 "cases": [
  {
   "id": "COV-01",
   "tier": 1,
   "title": "every tier-1 source file is a File node",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (f:File) RETURN f.file_path ORDER BY f.file_path",
    "max_rows": 1000,
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "rows": {
     "table": "",
     "col": "f.file_path",
     "includes": [
      "app/cli.py",
      "app/models.py",
      "app/money.py",
      "app/service.py",
      "app/util/strings.py",
      "hub/hub.py",
      "dup/alpha.py",
      "dup/beta.py",
      "unicode/ünïcødé.py",
      "tests/test_service.py",
      "java/src/main/java/com/example/billing/Money.java",
      "java/src/main/java/com/example/billing/Invoice.java",
      "java/src/main/java/com/example/billing/InvoiceService.java",
      "java/src/test/java/com/example/billing/InvoiceServiceTest.java"
     ],
     "excludes": [
      "vendor/thirdparty/lib.py",
      "generated/gen.py"
     ]
    }
   }
  },
  {
   "id": "COV-02",
   "tier": 2,
   "title": "tier-2 files (docs, infra, empty __init__) are File nodes too",
