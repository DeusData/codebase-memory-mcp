{
  "suite": "C-STATUS",
  "title": "Project listing, status, schema (both backends)",
  "spec": "specs/04_index_coverage.md",
  "backends": ["sqlite", "neo4j"],
  "cases": [
    {"id": "C00-01", "tier": 1, "title": "list_projects includes the project",
     "tool": "list_projects", "args": {"format": "json", "limit": 500}, "wait": 120,
     "expect": {"ok": true, "rows": {"table": "projects", "col": "name", "includes": "{{project}}"}}},
    {"id": "C00-02", "tier": 1, "title": "list_projects detail=stats carries node/edge counts",
     "tool": "list_projects", "args": {"format": "json", "detail": "stats", "limit": 500}, "wait": 120,
     "expect": {"ok": true, "rows": {"table": "projects", "contains_row": {"name": "{{project}}"}}, "deep_contains": "nodes"}},
    {"id": "C00-03", "tier": 1, "title": "index_status reports the backend kind of this profile",
     "tool": "index_status", "args": {"project": "{{project}}", "format": "json"}, "wait": 120,
     "expect": {"ok": true, "json": [{"path": "graph_backend.kind", "op": "eq", "value": "{{backend}}"}, {"path": "status", "op": "exists"}]}},
    {"id": "C00-04", "tier": 2, "title": "index_status diagnostics=summary adds coverage counts",
     "tool": "index_status", "args": {"project": "{{project}}", "format": "json", "diagnostics": "summary"}, "wait": 120,
     "expect": {"ok": true}},
    {"id": "C00-05", "tier": 2, "title": "index_status verbose adds git paths",
     "tool": "index_status", "args": {"project": "{{project}}", "format": "json", "verbose": true}, "wait": 120,
     "expect": {"ok": true}},
    {"id": "C00-06", "tier": 1, "title": "get_graph_schema lists the labels and edge types the fixture must produce",
     "tool": "get_graph_schema", "args": {"project": "{{project}}", "format": "json"}, "wait": 120,
     "expect": {"ok": true, "deep_contains": ["Function", "Class", "Method", "File", "CALLS", "DEFINES"]}},
    {"id": "C00-07", "tier": 1, "title": "get_graph_schema counts: File >= 14 (rows of node_labels)",
     "tool": "get_graph_schema", "args": {"project": "{{project}}", "format": "json", "limit": 500}, "wait": 120,
     "expect": {"ok": true, "rows": {"table": "node_labels", "col": "label", "includes": ["File", "Function", "Class", "Method"]}}},
    {"id": "C00-08", "tier": 2, "title": "get_graph_schema diagnostics=full lists queryable properties",
     "tool": "get_graph_schema", "args": {"project": "{{project}}", "format": "json", "diagnostics": "full"}, "wait": 120,
     "expect": {"ok": true, "deep_contains": ["file_path", "docstring"]}},
    {"id": "C00-09", "tier": 1, "title": "unknown project is a clear error with the available projects listed",
     "tool": "get_graph_schema", "args": {"project": "no-such-project-xyz", "format": "json"}, "wait": 120,
     "expect": {"ok": false, "error_contains": "not found"}},
    {"id": "C00-10", "tier": 1, "title": "schema answer names the backend (neo4j)", "skip_if": "sqlite",
     "tool": "get_graph_schema", "args": {"project": "{{project}}", "format": "json"}, "wait": 120,
     "expect": {"ok": true, "served_by": "neo4j"}},
    {"id": "C00-11", "tier": 1, "title": "schema answer has no graph_backend served_by (sqlite)", "skip_if": "neo4j",
     "tool": "get_graph_schema", "args": {"project": "{{project}}", "format": "json"}, "wait": 120,
     "expect": {"ok": true, "served_by": "sqlite"}},
    {"id": "C00-12", "tier": 1, "title": "tree format is the default and renders text",
     "tool": "get_graph_schema", "args": {"project": "{{project}}"}, "wait": 120,
     "expect": {"ok": true, "text_contains": "Function"}},
    {"id": "C00-13", "tier": 1, "title": "status and schema answer within 5 s",
     "tool": "index_status", "args": {"project": "{{project}}", "format": "json"}, "wait": 120,
     "expect": {"ok": true, "ms_under": 5000}}
  ]
}
