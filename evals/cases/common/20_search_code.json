{
  "suite": "C-SC",
  "title": "search_code: literal/regex text search with graph classification, filters, modes, paging, unicode, errors, root confinement",
  "spec": "specs/06_search_code.md",
  "backends": ["sqlite", "neo4j"],
  "cases": [
    {"id": "SC-01", "tier": 1, "title": "literal 'hub()' finds the 12 call sites and classifies them under the callers",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()", "format": "json", "result_limit": 50}, "wait": 300,
     "expect": {"ok": true, "ms_under": 20000, "json": [{"path": "total_grep_matches", "op": "gte", "value": 12}],
                "deep_contains": "hub/", "rows": {"table": "", "col": "qn", "any_match": "caller_"}}},
    {"id": "SC-02", "tier": 1, "title": "literal across two files",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "round_cents", "format": "json", "result_limit": 50}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "gte", "value": 3}], "deep_contains": ["app/money.py", "app/models.py"]}},
    {"id": "SC-03", "tier": 1, "title": "regex 'caller_[0-9]+' matches the 12 definitions plus the docstring line (13)",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "caller_[0-9]+", "regex": true, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "gte", "value": 12}, {"path": "total_grep_matches", "op": "lte", "value": 14}]}},
    {"id": "SC-04", "tier": 1, "title": "mode=files lists the files only",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "round_cents", "mode": "files", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "deep_contains": ["app/money.py", "app/models.py"], "deep_not_contains": "vendor/"}},
    {"id": "SC-05", "tier": 2, "title": "mode=full returns bounded source for the hits",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "def slugify", "mode": "full", "source_max_lines": 5, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "deep_contains": "join"}},
    {"id": "SC-06", "tier": 1, "title": "file_pattern *.java keeps Java hits only",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "total", "file_pattern": "*.java", "format": "json", "result_limit": 50}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "gte", "value": 1}], "deep_not_contains": [".py"]}},
    {"id": "SC-07", "tier": 1, "title": "path_filter scopes to a directory",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "issue", "path_filter": "java/src/test", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "deep_contains": "InvoiceServiceTest", "deep_not_contains": "InvoiceService.java"}},
    {"id": "SC-08", "tier": 1, "title": "unicode pattern in a unicode file name",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "ünïcode_fn", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "gte", "value": 1}], "deep_contains": "ünïcødé.py"}},
    {"id": "SC-09", "tier": 1, "title": "text that only exists in documentation is found and attributed to the doc file",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "intentionally unreferenced", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "eq", "value": 1}], "deep_contains": "docs/ARCHITECTURE.md"}},
    {"id": "SC-10", "tier": 1, "title": "ignored files are never searched: vendored_fn",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "vendored_fn", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "eq", "value": 0}]}},
    {"id": "SC-11", "tier": 1, "title": "ignored files are never searched: generated_fn",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "generated_fn", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "eq", "value": 0}]}},
    {"id": "SC-12", "tier": 1, "title": "invalid regex is a clear error",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "(", "regex": true, "format": "json"}, "wait": 300,
     "expect": {"ok": false}},
    {"id": "SC-13", "tier": 1, "title": "a literal '(' is fine without regex",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub(", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "gte", "value": 12}]}},
    {"id": "SC-14", "tier": 1, "title": "no match is a clean zero",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "zzqqxxnothing", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "eq", "value": 0}, {"path": "total_results", "op": "eq", "value": 0}]}},
    {"id": "SC-15", "tier": 1, "title": "result paging: result_limit 2 then result_offset 2",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()", "result_limit": 2, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "results_returned", "op": "eq", "value": 2}, {"path": "has_more", "op": "eq", "value": true}, {"path": "next_offset", "op": "eq", "value": 2}]}},
    {"id": "SC-16", "tier": 1, "title": "…second page",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()", "result_limit": 2, "result_offset": 2, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "result_offset", "op": "eq", "value": 2}], "same_as": [{"step": "SC-15", "path": "structured.total_results"}]}},
    {"id": "SC-17", "tier": 2, "title": "raw (unclassified) matches page separately",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "postgres", "raw_limit": 1, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "raw_returned", "op": "lte", "value": 1}]}},
    {"id": "SC-18", "tier": 2, "title": "raw_limit 0 suppresses raw lines",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "postgres", "raw_limit": 0, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "raw_returned", "op": "eq", "value": 0}]}},
    {"id": "SC-19", "tier": 2, "title": "context lines in full mode",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "raise ValidationError", "mode": "full", "context": 2, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "deep_contains": "if not order.lines"}},
    {"id": "SC-20", "tier": 2, "title": "debug=true adds phase timings",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()", "debug": true, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "scan_ms", "op": "exists"}]}},
    {"id": "SC-21", "tier": 2, "title": "quotes and format specifiers as a literal",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "String.format(\"%02d\"", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_grep_matches", "op": "gte", "value": 1}]}},
    {"id": "SC-22", "tier": 1, "title": "directory_limit paging of the directory histogram",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "import", "directory_limit": 1, "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "directories", "op": "exists"}]}},
    {"id": "SC-23", "tier": 1, "title": "the scan never leaves the repository root (no ../ paths in any answer)",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "evals", "path_filter": "../..", "format": "json"}, "wait": 300,
     "expect": {"deep_not_contains": "../", "text_not_contains": "../"}},
    {"id": "SC-24", "tier": 1, "title": "tree format renders",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()"}, "wait": 300,
     "expect": {"ok": true, "text_contains": "hub"}},
    {"id": "SC-25", "tier": 1, "title": "served from Neo4j (classification reads the graph remotely)", "skip_if": "sqlite",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "graph_backend.kind", "op": "eq", "value": "neo4j"}]}},
    {"id": "SC-26", "tier": 1, "title": "exact-match total is reported with total_relation",
     "tool": "search_code", "args": {"project": "{{project}}", "pattern": "hub()", "format": "json"}, "wait": 300,
     "expect": {"ok": true, "json": [{"path": "total_relation", "op": "in", "value": ["eq", "gte"]}]}}
  ]
}
