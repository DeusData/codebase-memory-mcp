{
 "suite": "C-QG",
 "title": "query_graph engine (Cypher subset): correctness on known truth, clauses, paging, unsupported syntax, missed graph",
 "spec": "specs/07_query_graph.md",
 "backends": [
  "sqlite",
  "neo4j"
 ],
 "cases": [
  {
   "id": "QG-01",
   "tier": 1,
   "title": "count all nodes",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (n) RETURN count(n)",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "ms_under": 10000,
    "json": [
     {
      "path": "rows.0.0",
      "op": "gte",
      "value": 60
     },
     {
      "path": "total_relation",
      "op": "eq",
      "value": "eq"
     }
    ]
   }
  },
  {
   "id": "QG-02",
   "tier": 1,
   "title": "hub has exactly 12 callers",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (c)-[:CALLS]->(h:Function {name:'hub'}) RETURN count(c)",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "ms_under": 5000,
    "json": [
     {
      "path": "rows.0.0",
      "op": "eq",
      "value": 12
     }
    ]
   }
  },
  {
   "id": "QG-03",
   "tier": 1,
   "title": "caller names in order",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (c)-[:CALLS]->(h:Function {name:'hub'}) RETURN c.name ORDER BY c.name",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "rows.0.0",
      "op": "eq",
      "value": "caller_01"
     },
     {
      "path": "rows.11.0",
      "op": "eq",
      "value": "caller_12"
     },
     {
      "path": "returned",
      "op": "eq",
      "value": 12
     }
    ]
   }
  },
  {
   "id": "QG-04",
   "tier": 1,
   "title": "dead-code query: no inbound and no outbound CALLS",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (f:Function) WHERE NOT EXISTS { (f)<-[:CALLS]-() } AND NOT EXISTS { (f)-[:CALLS]->() } RETURN f.name ORDER BY f.name",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "rows": {
     "table": "",
     "col": "f.name",
     "includes": "unused_helper",
     "excludes": [
      "hub",
      "caller_01",
      "format_cents"
     ]
    }
   }
  },
  {
   "id": "QG-05",
   "tier": 1,
   "title": "checkout calls validate and notify (same-file direct calls)",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (m:Method {name:'checkout'})-[:CALLS]->(x) RETURN x.name ORDER BY x.name",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "rows": {
     "table": "",
     "col": "x.name",
     "includes": [
      "validate",
      "notify"
     ]
    }
   }
  },
