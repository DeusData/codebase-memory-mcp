{
 "suite": "N-GEN",
 "title": "Neo4j generations: gen flip on full sync, single live generation, tamper detection, graph deleted by hand",
 "spec": "specs/02_indexing_neo4j.md",
 "backends": [
  "neo4j"
 ],
 "cases": [
  {
   "id": "N04-01",
   "tier": 1,
   "title": "current gen",
   "cypher": "MATCH (p:CbmProject {name: $project}) RETURN p.gen",
   "params": {
    "project": "{{project}}"
   },
   "expect": {
    "ok": true,
    "rows_eq": 1
   }
  },
  {
   "id": "N04-02",
   "tier": 1,
   "title": "force a full sync (remove the delta state file)",
   "fs": "delete",
   "path": "{{db_path}}.neo4j-state.db"
  },
  {
   "id": "N04-02a",
   "tier": 2,
   "title": "change a source file so a full sync actually runs",
   "fs": "append",
   "path": "app/cli.py",
   "content": "\n# eval: force a source change so the sync is not skipped as unchanged\n"
  },
  {
   "id": "N04-03",
   "tier": 1,
   "title": "re-index",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-04",
   "tier": 1,
   "title": "a full sync wrote a new generation (gen increased)",
   "cypher": "MATCH (p:CbmProject {name: $project}) RETURN p.gen > $prev",
   "params": {
    "project": "{{project}}"
   },
   "use_prev": [
    {
     "step": "N04-01",
     "path": "rows.0.0",
     "arg": "prev"
    }
   ],
   "expect": {
    "ok": true,
    "row_eq": [
     [
      true
     ]
    ]
   }
  },
  {
   "id": "N04-05",
   "tier": 1,
   "title": "the previous generation's rows were deleted",
   "cypher": "MATCH (n:CbmNode {db: $project, gen: $prev}) RETURN count(n)",
   "params": {
    "project": "{{project}}"
   },
   "use_prev": [
    {
     "step": "N04-01",
     "path": "rows.0.0",
     "arg": "prev"
    }
   ],
   "expect": {
    "ok": true,
    "row_eq": [
     [
      0
     ]
    ]
   }
  },
  {
   "id": "N04-06",
   "tier": 1,
   "title": "exactly one generation is live",
   "cypher": "MATCH (n:CbmNode {db: $project}) RETURN count(DISTINCT n.gen)",
   "params": {
    "project": "{{project}}"
   },
   "expect": {
    "ok": true,
    "row_eq": [
     [
      1
     ]
    ]
   }
  },
  {
   "id": "N04-07",
   "tier": 1,
   "title": "reads use the new generation",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json",
    "label": "Function"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "served_by": "neo4j",
    "rows": {
     "table": "",
     "col": "name",
     "count_eq": 1
    }
   }
  },
  {
   "id": "N04-07a",
   "tier": 2,
   "title": "restore app/cli.py",
   "shell": "git checkout -- app/cli.py",
   "expect": {
    "rc": 0
   }
  },
  {
   "id": "N04-07b",
   "tier": 2,
   "title": "re-index the restore",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-08",
   "tier": 2,
   "title": "TAMPER: move CbmProject.gen by hand (test instance only)",
   "cypher": "MATCH (p:CbmProject {name: $project}) SET p.gen = p.gen + 1000 RETURN p.gen",
   "params": {
    "project": "{{project}}"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-09",
   "tier": 1,
   "title": "…graph reads refuse to answer from a generation that is not the local one (no silent fallback)",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "json": [
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "unavailable"
     }
    ]
   }
  },
  {
   "id": "N04-10",
   "tier": 1,
   "title": "…query_graph too",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (n) RETURN count(n)",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false
   }
  },
  {
   "id": "N04-11",
   "tier": 1,
   "title": "…index_status still works and names the reason",
   "tool": "index_status",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "unavailable"
     },
     {
      "path": "graph_backend.reason",
      "op": "exists"
     }
    ]
   }
  },
  {
   "id": "N04-12",
   "tier": 1,
   "title": "…list_projects still works",
   "tool": "list_projects",
   "args": {
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-13",
   "tier": 2,
   "title": "…undo the tamper",
   "cypher": "MATCH (p:CbmProject {name: $project}) SET p.gen = p.gen - 1000 RETURN p.gen",
   "params": {
    "project": "{{project}}"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-14",
   "tier": 1,
   "title": "…serving again without a re-index",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "served_by": "neo4j"
   }
  },
  {
   "id": "N04-15",
   "tier": 2,
   "title": "DELETED BY HAND: remove the project's graph from Neo4j (test instance only)",
   "cypher": "MATCH (n:CbmNode {db: $project}) DETACH DELETE n",
   "params": {
    "project": "{{project}}"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-16",
   "tier": 2,
   "title": "…a read now returns an error or an empty answer, never a stale local answer",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "any_of": [
     {
      "ok": false
     },
     {
      "rows": {
       "table": "",
       "count_lte": 0
      }
     }
    ]
   }
  },
  {
   "id": "N04-17",
   "tier": 1,
   "title": "…re-index repairs it with a full upload",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "nodes",
      "op": "gte",
      "value": 100
     }
    ]
   }
  },
  {
   "id": "N04-18",
   "tier": 2,
   "title": "…which index_status reports as full",
   "tool": "index_status",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "serving"
     },
     {
      "path": "graph_backend.last_sync",
      "op": "regex",
      "value": "^full"
     }
    ]
   }
  },
  {
   "id": "N04-19",
   "tier": 1,
   "title": "…hub is back with 12 callers",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (c)-[:CALLS]->(h:Function {name:'hub'}) RETURN count(c)",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "served_by": "neo4j",
    "json": [
     {
      "path": "rows.0.0",
      "op": "eq",
      "value": 12
     }
    ]
   }
  },
  {
   "id": "N04-19a",
   "tier": 2,
   "title": "repair: change a source file",
   "fs": "append",
   "path": "app/cli.py",
   "content": "\n# eval: force a source change so the sync is not skipped as unchanged\n"
  },
  {
   "id": "N04-19b",
   "tier": 2,
   "title": "repair: drop the local delta state so the sync is full",
   "fs": "delete",
   "path": "{{db_path}}.neo4j-state.db"
  },
  {
   "id": "N04-19c",
   "tier": 1,
   "title": "repair: re-index with a real change",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-19d",
   "tier": 1,
   "title": "after a real change the graph is back with 12 hub callers",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (c)-[:CALLS]->(h:Function {name:'hub'}) RETURN count(c)",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "rows.0.0",
      "op": "eq",
      "value": 12
     }
    ]
   }
  },
  {
   "id": "N04-19e",
   "tier": 2,
   "title": "restore app/cli.py",
   "shell": "git checkout -- app/cli.py",
   "expect": {
    "rc": 0
   }
  },
  {
   "id": "N04-19f",
   "tier": 2,
   "title": "re-index the restore",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N04-20",
   "tier": 1,
   "title": "CbmProject carries the SQLite generation string the tools compare against",
   "tool": "index_status",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "graph_backend.synced_generation",
      "op": "exists"
     },
     {
      "path": "graph_backend.local_generation",
      "op": "exists"
     }
    ]
   }
  },
  {
   "id": "N04-21",
   "tier": 1,
   "title": "…equal to CbmProject.generation",
   "cypher": "MATCH (p:CbmProject {name: $project}) RETURN toString(p.generation)",
   "params": {
    "project": "{{project}}"
   },
   "expect": {
    "ok": true,
    "same_as": [
     {
      "step": "N04-20",
      "path": "structured.graph_backend.synced_generation",
      "this_path": "rows.0.0"
     }
    ]
   }
  }
 ]
}