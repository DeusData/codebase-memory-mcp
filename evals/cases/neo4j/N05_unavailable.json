{
 "suite": "N-DOWN",
 "title": "Neo4j unavailable: fail fast, name the cause, recover; bad credentials; no silent local answers",
 "spec": "specs/10_failure_security.md",
 "backends": [
  "neo4j"
 ],
 "cases": [
  {
   "id": "N05-01",
   "tier": 1,
   "title": "stop the Neo4j container",
   "skip_if": "no_var:neo4j_container",
   "shell": "docker stop {{neo4j_container}}",
   "wait": 120,
   "expect": {
    "rc": 0
   }
  },
  {
   "id": "N05-02",
   "tier": 1,
   "title": "search_graph fails fast with status unavailable",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000,
    "json": [
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "unavailable"
     },
     {
      "path": "graph_backend.reason",
      "op": "exists"
     }
    ],
    "text_regex": "(?i)neo4j"
   }
  },
  {
   "id": "N05-03",
   "tier": 1,
   "title": "query_graph fails fast",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "MATCH (n) RETURN count(n)",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-04",
   "tier": 1,
   "title": "trace_path fails fast",
   "tool": "trace_path",
   "args": {
    "project": "{{project}}",
    "function_name": "hub",
    "direction": "inbound",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-05",
   "tier": 1,
   "title": "get_code_snippet fails fast",
   "tool": "get_code_snippet",
   "args": {
    "project": "{{project}}",
    "qualified_name": "{{project}}.hub.hub.hub",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-06",
   "tier": 1,
   "title": "search_code fails fast (its graph classification needs Neo4j)",
   "tool": "search_code",
   "args": {
    "project": "{{project}}",
    "pattern": "hub()",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-07",
   "tier": 1,
   "title": "get_graph_schema fails fast",
   "tool": "get_graph_schema",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-08",
   "tier": 1,
   "title": "detect_changes fails rather than reporting zero impact",
   "tool": "detect_changes",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-09",
   "tier": 1,
   "title": "native query_graph fails fast",
   "tool": "query_graph",
   "args": {
    "project": "{{project}}",
    "query": "RETURN 1",
    "native": true,
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-10",
   "tier": 1,
   "title": "index_status keeps working and says unavailable + reason",
   "tool": "index_status",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "ms_under": 20000,
    "json": [
     {
      "path": "graph_backend.kind",
      "op": "eq",
      "value": "neo4j"
     },
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "unavailable"
     },
     {
      "path": "graph_backend.reason",
      "op": "exists"
     }
    ]
   }
  },
  {
   "id": "N05-11",
   "tier": 1,
   "title": "list_projects keeps working",
   "tool": "list_projects",
   "args": {
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-12",
   "tier": 2,
   "title": "check_index_coverage reads graph nodes, so it is refused like every graph read (no local fallback) and names the cause",
   "tool": "check_index_coverage",
   "args": {
    "project": "{{project}}",
    "paths": [
     "app/money.py"
    ],
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": false,
    "text_regex": "(?i)neo4j",
    "json": [
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "unavailable"
     }
    ]
   }
  },
  {
   "id": "N05-13",
   "tier": 1,
   "title": "a re-index that cannot sync fails and says so",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": false,
    "text_regex": "(?i)neo4j"
   }
  },
  {
   "id": "N05-14",
   "tier": 2,
   "title": "…index_status records last_sync_error",
   "tool": "index_status",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "graph_backend.last_sync_error",
      "op": "exists"
     }
    ]
   }
  },
  {
   "id": "N05-15",
   "tier": 1,
   "title": "the error is reported in bounded time even for a second call (no retry storm)",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 20000
   }
  },
  {
   "id": "N05-16",
   "tier": 1,
   "title": "start Neo4j again",
   "skip_if": "no_var:neo4j_container",
   "shell": "docker start {{neo4j_container}}",
   "wait": 120,
   "expect": {
    "rc": 0
   }
  },
  {
   "id": "N05-17",
   "tier": 1,
   "title": "wait until the HTTP API answers",
   "shell": "{{python}} -c \"import sys,time,urllib.request\nfor i in range(120):\n    try:\n        urllib.request.urlopen(sys.argv[1], timeout=3).read(); print('neo4j_up'); sys.exit(0)\n    except Exception: time.sleep(2)\nprint('neo4j_down'); sys.exit(1)\" \"{{graph_db}}\"",
   "wait": 300,
   "expect": {
    "rc": 0,
    "stdout_contains": "neo4j_up"
   }
  },
  {
   "id": "N05-18",
   "sleep": 5
  },
  {
   "id": "N05-19",
   "tier": 1,
   "title": "re-index to resync (the failed run left the local index ahead of Neo4j)",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}",
    "format": "json"
   },
   "wait": 1800,
   "expect": {
    "ok": true
   }
  },
  {
   "id": "N05-20",
   "tier": 1,
   "title": "serving and in sync again, no lingering sync error",
   "tool": "index_status",
   "args": {
    "project": "{{project}}",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "json": [
     {
      "path": "graph_backend.status",
      "op": "eq",
      "value": "serving"
     },
     {
      "path": "graph_backend.in_sync",
      "op": "eq",
      "value": true
     },
     {
      "path": "graph_backend.last_sync_error",
      "op": "missing"
     }
    ]
   }
  },
  {
   "id": "N05-21",
   "tier": 1,
   "title": "graph reads come from Neo4j again",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "served_by": "neo4j"
   }
  },
  {
   "id": "N05-22",
   "tier": 2,
   "title": "wrong password on a new project: clear error, fast, nothing registered (one attempt only: Neo4j locks after repeated failures)",
   "tool": "index_repository",
   "args": {
    "repo_path": "{{repo}}",
    "name": "{{project}}-badpw",
    "graph_db": "{{graph_db}}",
    "graph_user": "{{neo4j_user}}",
    "graph_password": "definitely-not-the-password",
    "format": "json"
   },
   "wait": 300,
   "expect": {
    "ok": false,
    "ms_under": 30000,
    "text_regex": "(?i)neo4j|auth|login|401|unauthori",
    "text_not_contains": "definitely-not-the-password"
   }
  },
  {
   "id": "N05-23",
   "tier": 2,
   "title": "…not registered",
   "tool": "list_projects",
   "args": {
    "format": "json",
    "limit": 500
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "rows": {
     "table": "projects",
     "col": "name",
     "excludes": "{{project}}-badpw"
    }
   }
  },
  {
   "id": "N05-24",
   "tier": 1,
   "title": "…the existing project still serves with its remembered credentials",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "served_by": "neo4j"
   }
  },
  {
   "id": "N05-25",
   "tier": 2,
   "title": "workaround: restart the daemon",
   "session": "restart",
   "daemon_stop": true
  },
  {
   "id": "N05-26",
   "tier": 1,
   "title": "after a daemon restart the project reads again",
   "tool": "search_graph",
   "args": {
    "project": "{{project}}",
    "name_pattern": "^hub$",
    "label": "Function",
    "format": "json"
   },
   "wait": 120,
   "expect": {
    "ok": true,
    "served_by": "neo4j"
   }
  }
 ]
}
