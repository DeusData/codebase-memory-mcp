  "cards": [
    {
      "dot": "emerald",
      "title": "Ingestion Pipeline",
      "items": [
        "Raw disk files are transformed into LZ4 compressed in-memory blocks",
        "Tree-Sitter C runtime converts text into concrete syntax trees without external processes",
        "AST symbol table registers functions, classes, interfaces, and packages"
      ]
    },
    {
      "dot": "cyan",
      "title": "Knowledge Graph Model",
      "items": [
        "Nodes represent semantic code constructs and infrastructure entities",
        "Edges represent CALLS, IMPORTS, DEFINES, and TYPE_OF relationships",
        "Hybrid LSP enriches raw AST edges with true cross-file semantic typing"
      ]
    },
    {
      "dot": "amber",
      "title": "Consumer Distribution",
      "items": [
        "AI Agents receive token-compressed tool responses over stdio",
        "Cypher engine answers ad-hoc multi-hop pattern queries in under 1 millisecond",
        "Embedded HTTP daemon serves 3D force-directed graph to developer browsers"
      ]
    }
  ]
}
