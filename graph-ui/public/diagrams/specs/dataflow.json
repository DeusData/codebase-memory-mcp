    { "id": "mem_cache", "type": "database", "label": "In-Memory Cache", "sublabel": "FQN hash table", "stage": 3, "row": 0 },
    { "id": "sqlite_db", "type": "database", "label": "SQLite Store", "sublabel": "WAL graph tables", "stage": 3, "row": 1 },
    { "id": "layout_store", "type": "database", "label": "3D Layout Store", "sublabel": "octree coordinates", "stage": 3, "row": 2 },
    { "id": "agent_mcp", "type": "frontend", "label": "Agent Tools API", "sublabel": "17 tools over stdio", "stage": 4, "row": 0 },
    { "id": "cypher_engine", "type": "backend", "label": "Cypher Engine", "sublabel": "graph traversal", "stage": 4, "row": 1 },
