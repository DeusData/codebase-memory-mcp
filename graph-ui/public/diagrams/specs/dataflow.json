  "flows": [
    { "id": "f1", "from": "src_files", "to": "source_lz4", "label": "bulk read", "classification": "raw bytes", "variant": "default", "route": "straight", "labelDy": -18 },
    { "id": "f2", "from": "src_files", "to": "tree_sitter", "label": "parse code", "classification": "source lines", "variant": "emphasis", "labelDy": 24 },
    { "id": "f3", "from": "git_repo", "to": "infra_scan", "label": "manifests", "classification": "config", "variant": "default", "route": "straight" },
    { "id": "f4", "from": "source_lz4", "to": "symbols_fqn", "label": "token stream", "classification": "tokens", "variant": "default", "route": "straight" },
    { "id": "f5", "from": "tree_sitter", "to": "hybrid_lsp", "label": "call sites", "classification": "syntax", "variant": "emphasis", "route": "straight" },
    { "id": "f6", "from": "infra_scan", "to": "graph_buffer", "label": "infra edges", "classification": "IaC nodes", "variant": "default", "route": "straight" },
    { "id": "f7", "from": "symbols_fqn", "to": "mem_cache", "label": "index FQN", "classification": "in-memory", "variant": "default", "route": "straight" },
    { "id": "f8", "from": "hybrid_lsp", "to": "sqlite_db", "label": "type edges", "classification": "relational rows", "variant": "emphasis", "route": "straight" },
    { "id": "f9", "from": "graph_buffer", "to": "layout_store", "label": "3D coords", "classification": "spatial", "variant": "default", "route": "straight" },
    { "id": "f10", "from": "mem_cache", "to": "agent_mcp", "label": "symbol lookup", "classification": "sub-ms", "variant": "emphasis", "route": "straight" },
    { "id": "f11", "from": "sqlite_db", "to": "cypher_engine", "label": "pattern query", "classification": "SQL match", "variant": "emphasis", "route": "straight" },
