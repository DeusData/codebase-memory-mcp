    { "id": "source_lz4", "type": "backend", "label": "LZ4 Source Cache", "sublabel": "compressed blocks", "stage": 1, "row": 0 },
    { "id": "tree_sitter", "type": "backend", "label": "Tree-Sitter AST", "sublabel": "C grammar parser", "stage": 1, "row": 1 },
    { "id": "infra_scan", "type": "cloud", "label": "Infra Scanner", "sublabel": "K8s & Dockerfiles", "stage": 1, "row": 2 },
    { "id": "symbols_fqn", "type": "backend", "label": "Symbol Registry", "sublabel": "functions & classes", "stage": 2, "row": 0 },
    { "id": "hybrid_lsp", "type": "backend", "label": "Hybrid LSP", "sublabel": "type resolution", "stage": 2, "row": 1 },
