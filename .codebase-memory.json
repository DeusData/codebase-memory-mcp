{
  "test_impact": {
    "version": 1,
    "tests": {
      "presets": {
        "c-cbm": true
      }
    },
    "rules": [
      {
        "id": "harness",
        "paths": ["tests/test_framework.h", "tests/test_helpers.*", "tests/test_main.c"],
        "action": "run_all"
      },
      {
        "id": "engine",
        "paths": [
          ".codebase-memory.json",
          "src/mcp/test_impact*",
          "src/store/store_impact.*",
          "scripts/test-impact/**",
          "scripts/ci/test-impact-*"
        ],
        "action": "run_all"
      },
      {
        "id": "build",
        "paths": [
          "scripts/build.sh",
          "scripts/env.sh",
          "scripts/test.sh",
          "scripts/run-tests-parallel.sh",
          "scripts/run-test-wave.py",
          "scripts/path-safety.sh",
          "scripts/clean.sh",
          "scripts/suite-failure-report.sh",
          "scripts/ci/verify-shard-union.sh",
          "scripts/embed-frontend.sh",
          "/.gitattributes"
        ],
        "action": "run_all"
      },
      {
        "id": "grammars",
        "paths": ["internal/cbm/vendored/**"],
        "action": "run_all"
      },
      {
        "id": "fixtures",
        "paths": ["tests/fixtures/*/**"],
        "action": "referencing_tests",
        "key": "path_segment:2"
      },
      {
        "id": "contracts",
        "paths": ["tests/**/*.{sh,py,json,txt,ps1}"],
        "action": "ignore"
      },
      {
        "id": "notices",
        "paths": ["NOTICE*", "CHANGELOG*", "THIRD_PARTY*"],
        "action": "ignore"
      },
      {
        "id": "repo-data",
        "paths": [
          "scripts/**",
          "pkg/**",
          "test-infrastructure/**",
          "docs/**",
          "**/*.md",
          "graph-ui/**",
          "tools/**",
          "tests/fuzz/corpus/**",
          "/{.clang-format,.clang-tidy,.cppcheck,.gitignore,.gitleaksignore,DCO,Formula}",
          "/{flake.lock,flake.nix,glama.json,install.ps1,install.sh,server.json}"
        ],
        "action": "referencing_tests",
        "key": "path",
        "unreferenced": "ignore"
      }
    ],
    "unmapped_files": "run_all",
    "coverage": {
      "compatibility_paths": [
        "tests/test_framework.h",
        "tests/test_main.c",
        "tests/test_helpers.h",
        "Makefile.cbm",
        "scripts/test-impact/coverage-map.py",
        "scripts/test-impact/coverage-merge.py"
      ]
    }
  }
}
